#!/usr/bin/env bash
# Skullcandy HQ launcher (generated by install.sh from launch-skullhq.sh.in).
# Starts the native HID bridge helper, then launches Skull-HQ under SYSTEM Wine
# with the bridging hid.dll override so the headset is fully controllable.
set -u

WINEPREFIX="@WINEPREFIX@"
INSTALL_DIR="@INSTALL_DIR@"
APP="@APP_EXE@"
AIROHA_DIR="@AIROHA_DIR@"

export WINEPREFIX
# IMPORTANT: use the system Wine (good HID support), not Proton/GE-Proton.
export WINEDLLOVERRIDES="hid=n,b"

# 1. Ensure the HID bridge helper is running.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user is-active --quiet hidbridge 2>/dev/null || {
        systemctl --user reset-failed hidbridge 2>/dev/null
        systemctl --user start hidbridge 2>/dev/null \
            || systemd-run --user --unit=hidbridge python3 "$INSTALL_DIR/hidbridge.py" >/dev/null 2>&1
    }
else
    pgrep -f "$INSTALL_DIR/hidbridge.py" >/dev/null 2>&1 \
        || setsid python3 "$INSTALL_DIR/hidbridge.py" >/tmp/hidbridge.log 2>&1 < /dev/null &
fi

# 2. Best-effort: make hidraw nodes accessible (no-op if the udev rule already did).
for h in /dev/hidraw*; do [ -e "$h" ] && chmod 0666 "$h" 2>/dev/null || true; done

# 3. Keep the bridge DLLs in place (survives app updates/reinstalls).
if [ -n "$AIROHA_DIR" ] && [ -d "$AIROHA_DIR" ]; then
    [ -f "$AIROHA_DIR/hidwine.dll" ] || cp "@WINE_HID_DLL@" "$AIROHA_DIR/hidwine.dll" 2>/dev/null || true
    [ -f "$INSTALL_DIR/hid_bridge.dll" ] && cp "$INSTALL_DIR/hid_bridge.dll" "$AIROHA_DIR/hid.dll" 2>/dev/null || true
fi

# 4. Launch.
exec wine "$APP" "$@"
